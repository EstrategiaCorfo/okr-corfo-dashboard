{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/**",
              "components/core/**",
              "components/slides/**",
              "tools/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Aptos Display|Calibri|Carlito))/i]",
        "message": "Font not provided by the design system. Available: Aptos Display, Calibri, Carlito."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentRule'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|height|color|style|key|ref|className|style|children)$/]",
        "message": "<AccentRule> doesn't accept that prop. Declared props: width, height, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BulletItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|divider|size|style|key|ref|className|style|children)$/]",
        "message": "<BulletItem> doesn't accept that prop. Declared props: children, divider, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColumnCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|children|style|key|ref|className|style|children)$/]",
        "message": "<ColumnCard> doesn't accept that prop. Declared props: number, title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CorfoLogo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|height|base|style|key|ref|className|style|children)$/]",
        "message": "<CorfoLogo> doesn't accept that prop. Declared props: variant, height, base, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CorfoLogo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:azul|blanco)$/]",
        "message": "<CorfoLogo> variant must be one of 'azul' | 'blanco'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlowStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|variant|style|key|ref|className|style|children)$/]",
        "message": "<FlowStep> doesn't accept that prop. Declared props: title, subtitle, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlowStep'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|solid)$/]",
        "message": "<FlowStep> variant must be one of 'outline' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NoteBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<NoteBanner> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NumberedItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|description|divider|style|key|ref|className|style|children)$/]",
        "message": "<NumberedItem> doesn't accept that prop. Declared props: number, title, description, divider, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideAgenda'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|items|number|footerLabel|assetsBase|style|key|ref|className|style|children)$/]",
        "message": "<SlideAgenda> doesn't accept that prop. Declared props: title, items, number, footerLabel, assetsBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideColumns'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|lead|columns|note|number|footerLabel|assetsBase|style|key|ref|className|style|children)$/]",
        "message": "<SlideColumns> doesn't accept that prop. Declared props: title, lead, columns, note, number, footerLabel, assetsBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideContentPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|lead|bullets|steps|number|footerLabel|assetsBase|style|key|ref|className|style|children)$/]",
        "message": "<SlideContentPanel> doesn't accept that prop. Declared props: title, lead, bullets, steps, number, footerLabel, assetsBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideCover'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|date|assetsBase|style|key|ref|className|style|children)$/]",
        "message": "<SlideCover> doesn't accept that prop. Declared props: title, date, assetsBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|number|onDark|style|key|ref|className|style|children)$/]",
        "message": "<SlideFooter> doesn't accept that prop. Declared props: label, number, onDark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlidePhotoFull'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|text|image|assetsBase|style|key|ref|className|style|children)$/]",
        "message": "<SlidePhotoFull> doesn't accept that prop. Declared props: title, text, image, assetsBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideQuote'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|author|role|portrait|number|footerLabel|assetsBase|style|key|ref|className|style|children)$/]",
        "message": "<SlideQuote> doesn't accept that prop. Declared props: quote, author, role, portrait, number, footerLabel, assetsBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideSection'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|subtitle|assetsBase|style|key|ref|className|style|children)$/]",
        "message": "<SlideSection> doesn't accept that prop. Declared props: number, title, subtitle, assetsBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideTimeline'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|lead|milestones|number|footerLabel|assetsBase|style|key|ref|className|style|children)$/]",
        "message": "<SlideTimeline> doesn't accept that prop. Declared props: title, lead, milestones, number, footerLabel, assetsBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatFigure'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|description|size|style|key|ref|className|style|children)$/]",
        "message": "<StatFigure> doesn't accept that prop. Declared props: value, label, description, size, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
